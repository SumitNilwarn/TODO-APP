# ---------------------------------------------------------------------------
# Todo App - environment configuration example
#
# COPY THIS FILE TO .env (per environment) AND FILL IN REAL VALUES.
# Never commit real credentials. Every project has its own .env.
#
# The backend reads these values from the actual process environment.
# Docker Compose reads them from infrastructure/.env (see infrastructure/).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# PostgreSQL (development database)
# ---------------------------------------------------------------------------
DB_HOST=localhost
# Host port as published by Docker Compose (the container port is 5432, and the
# backend inside Compose always uses the "postgres" service name on 5432). Keep
# 5433 unless you run a native PostgreSQL on the default 5432.
DB_PORT=5433
DB_NAME=todo_app
DB_USERNAME=todo_app
DB_PASSWORD=todo_app          # CHANGE ME in non-local environments

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
SERVER_PORT=8080
# Frontend origins allowed for CORS (comma separated). Dev defaults are fine.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Spring profile (dev | test | prod)
SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------------------------------------
# Authentication (Spring Security / JWT)
# ---------------------------------------------------------------------------
# Change me to a strong, unique value (>= 32 chars) in every non-local environment.
JWT_SECRET=todo-app-local-development-jwt-secret-change-me
# Token issuer claim shown in OpenAPI/audit (match JWT_ISSUER on all instances).
JWT_ISSUER=todo-app
# Access-token lifetime in seconds (default 900 = 15 minutes).
JWT_ACCESS_TOKEN_EXPIRATION=900
# Refresh-token (session) lifetime ceiling in seconds (default 2592000 = 30 days).
JWT_REFRESH_TOKEN_EXPIRATION=2592000

# ---------------------------------------------------------------------------
# Frontend (Flutter Web)
# ---------------------------------------------------------------------------
# Base URL of the backend REST API consumed by the Flutter app.
# Passed at build/run time via --dart-define=API_BASE_URL=...
API_BASE_URL=http://localhost:8080