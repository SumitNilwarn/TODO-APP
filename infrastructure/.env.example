# ---------------------------------------------------------------------------
# Docker Compose environment template (infrastructure/)
#
# Copy this file to infrastructure/.env and adjust values as needed.
# docker compose automatically reads infrastructure/.env for variable
# substitution in docker-compose.yml.
#
# ALL values here are non-secret placeholders. Real values belong only in
# infrastructure/.env, which is git-ignored and never committed.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# PostgreSQL (PostgreSQL 16)
#
# Inside Compose, the backend connects to the service name "postgres" on the
# container port 5432 (never localhost). The HOST port skew exists to keep
# TODO's local DB away from the unrelated url-shortener project which owns
# 5432 on the host.
# ---------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5433
DB_NAME=todo_app
DB_USERNAME=todo_app
DB_PASSWORD=         # <-- replace in infrastructure/.env (local dev only)

# ---------------------------------------------------------------------------
# Backend (Spring Boot / Java 21)
# ---------------------------------------------------------------------------
BACKEND_PORT=8080        # Host-mapped port for the backend container
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
SERVER_PORT=8080
API_BASE_URL=http://localhost:8080   # Browser-visible backend URL (frontend)

# JWT (local development placeholders only — never use in real environments)
JWT_SECRET=             # <-- replace in infrastructure/.env
JWT_ISSUER=todo-app
JWT_ACCESS_TOKEN_EXPIRATION=900
JWT_REFRESH_TOKEN_EXPIRATION=2592000

# ---------------------------------------------------------------------------
# Frontend (Flutter Web / nginx)
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000       # Host-mapped port for the frontend container
